# Exec85 init table (busybox init). Order: early mounts + hardware, OpenRC services, then the UI.
::sysinit:/etc/exec85/early-boot.sh
::sysinit:/etc/exec85/start-splash.sh
::wait:/sbin/openrc default
tty1::respawn:/usr/bin/exec85
::ctrlaltdel:/sbin/reboot
# Signal QUIT (sent by the installer disc to start an installed system): replace init by the hand-over script.
::restart:/etc/exec85/handoff.sh
::shutdown:/sbin/openrc shutdown
::shutdown:/bin/umount -a -r
