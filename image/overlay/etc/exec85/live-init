#!/bin/sh
# PID 1 of the install disc (kernel option rdinit=/etc/exec85/live-init). Before anything else starts it asks: is Exec85
# already installed here? If so, and the person (or the countdown) says "start it", it switches to the installed disk
# right now, without a reboot, so the computer's boot order does not matter. Otherwise it becomes the normal init.
# The kernel starts this with no search path; without one `xargs modprobe` (loading drivers by hardware name) cannot find modprobe.
export PATH=/sbin:/usr/sbin:/bin:/usr/bin
say() { echo "EXEC85_HANDOFF $*" > /dev/console 2>/dev/null; }
/etc/exec85/early-boot.sh        # mounts, drivers (the init table runs it again later; it then does nothing)
touch /.early-done
if ! grep -qw exec85.reinstall /proc/cmdline; then
  /usr/bin/exec85 --existing
  if [ $? -eq 10 ]; then
    dev=$(cat /handoff-root 2>/dev/null)
    mkdir -p /newroot
    if [ -n "$dev" ] && mount -t ext4 -o rw "$dev" /newroot; then
      mkdir -p /newroot/etc/exec85
      echo 1 > /newroot/etc/exec85/handed-over
      for m in dev proc sys; do mkdir -p /newroot/$m; mount -o move /$m /newroot/$m; done
      say "switching to $dev"
      : > /init        # busybox switch_root insists that the old root has an /init file (it only checks that it is a regular file)
      exec switch_root /newroot /sbin/init
    fi
    say "could not mount $dev; carrying on with the installer"
  fi
fi
exec /sbin/init
